{
  "name": "repoq",
  "version": "0.1.0",
  "description": "Local pull request turns for coding agents. Queue, yield, resume.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=24.13.0" },
  "os": ["darwin", "linux"],
  "bin": { "repo-queue": "bin/repo-queue" },
  "files": ["bin/", "dist/", "skills/", "assets/", "README.md", "LICENSE", "SECURITY.md", "docs/"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "validate": "npm run check && npm run build && npm test",
    "prepack": "npm run build"
  },
  "repository": { "type": "git", "url": "https://github.com/jesse-merhi/repo-queue.git" },
  "bugs": { "url": "https://github.com/jesse-merhi/repo-queue/issues" },
  "devDependencies": { "@types/node": "24.13.3", "typescript": "5.9.3" }
}
