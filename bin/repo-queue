#!/usr/bin/env node
const [major, minor] = process.versions.node.split('.').map(Number);
if (major < 24 || (major === 24 && minor < 13)) {
  console.error('RepoQ requires Node.js 24.13 or newer.');
  process.exitCode = 1;
} else if (!['darwin', 'linux'].includes(process.platform)) {
  console.error('RepoQ currently supports macOS and Linux.');
  process.exitCode = 1;
} else {
  const { main } = await import('../dist/cli.js');
  await main(process.argv.slice(2));
}
